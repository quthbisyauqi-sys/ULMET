{
  "version": 2,
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/share-target",
      "destination": "/pages/materi.html?shared=1"
    },
    {
      "source": "/(admin|ai|catatan|dashboard|jadwal|keuangan|login|materi|profil|widget).html",
      "destination": "/pages/$1.html"
    },
    {
      "source": "/(clear|clear-cache).html",
      "destination": "/tools/$1.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
